FROM sonarsource/sonar-scanner-cli:latest

# Définir le répertoire de travail
WORKDIR /usr/src

# 1. Copier explicitement uniquement les répertoires/fichiers nécessaires
COPY back /usr/src/back
COPY front /usr/src/front
COPY sonar-project.properties /usr/src/sonar-project.properties

# 2. Utiliser un utilisateur non-root (fourni par l'image officielle)
USER scannercli